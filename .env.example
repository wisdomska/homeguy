# HomeGuy environment variables
#
# Copy to .env.local for development. Every variable is listed here with
# where to get it. Nothing secret is prefixed NEXT_PUBLIC_ — anything with
# that prefix reaches the browser and is reviewed on the way in.
#
# Three databases, never shared:
#   local      -> your machine
#   staging    -> the staging branch deployment
#   production -> main
# Staging must never point at production data. A staging job that re-checks
# every source URL against live listings is a crawl nobody consented to.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres connection string.
# Local:      docker run -e POSTGRES_PASSWORD=homeguy -p 5432:5432 postgres:16
#             then DATABASE_URL="postgresql://postgres:homeguy@localhost:5432/homeguy"
# Staging:    Vercel dashboard -> Storage -> create a Neon/Postgres database
#             named homeguy-staging, copy DATABASE_URL, scope it to Preview.
# Production: same, named homeguy-production, scoped to Production only.
# When unset, the app reads the deterministic development dataset in
# src/core/generate.ts and says so on the landing page.
DATABASE_URL=

# Direct (non-pooled) connection, used by migrations only.
# Neon dashboard -> Connection details -> "Direct connection".
DIRECT_DATABASE_URL=

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# Basic auth for /admin/health and the report queue. Set these or /admin
# returns 503 — it is never open by default.
# Generate: openssl rand -base64 24
ADMIN_USER=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
# Shared secret Vercel Cron presents to /api/cron/*. Without it those
# endpoints return 401 to everyone.
# Generate: openssl rand -hex 32
# Set it in Vercel -> Settings -> Environment Variables, all environments.
CRON_SECRET=

# Optional: override the crawl politeness floor for a local test run.
# Never set this below 2000 against a real host.
# INGEST_MIN_HOST_INTERVAL_MS=2000

# ---------------------------------------------------------------------------
# Digest delivery
# ---------------------------------------------------------------------------
# WhatsApp, via the Meta Cloud API. Proactive messages are paid templates
# only (Research Dossier C8), so this sends a pre-approved digest template
# and nothing else.
# developers.facebook.com -> your app -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DIGEST_TEMPLATE=homeguy_digest

# Email, via Resend. resend.com -> API Keys -> Create.
RESEND_API_KEY=
RESEND_FROM="HomeGuy <digest@homeguy.vercel.app>"

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Sentry. sentry.io -> Settings -> Projects -> homeguy -> Client Keys (DSN).
# This one reaches the browser deliberately; a DSN is not a secret.
NEXT_PUBLIC_SENTRY_DSN=
# sentry.io -> Settings -> Auth Tokens. Used in CI to upload source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=homeguy
# Keep this low enough that observability costs less than the product earns.
SENTRY_TRACES_SAMPLE_RATE=0.05

# ---------------------------------------------------------------------------
# Set by Vercel. Listed so you know what the code reads.
# ---------------------------------------------------------------------------
# VERCEL_ENV          production | preview | development
#                     Everything except "production" is noindex, in
#                     next.config.ts, middleware.ts and robots.ts.
# VERCEL_URL          the deployment's own hostname
# VERCEL_GIT_COMMIT_SHA  used as the Sentry release
