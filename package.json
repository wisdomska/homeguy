{
  "name": "homeguy",
  "version": "0.1.0",
  "private": true,
  "description": "Rental-listing aggregator and house-hunt tracker for Ghana",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "a11y": "playwright test --grep @a11y",
    "bundle": "node scripts/bundle-check.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "ingest:run": "tsx src/ingest/cli.ts",
    "vercel-build": "prisma generate && node scripts/migrate-if-configured.mjs && next build"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vercel/analytics": "^1.4.1",
    "next": "^15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.25",
    "prisma": "6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
